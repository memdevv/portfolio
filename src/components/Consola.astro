---
import { Icon } from 'astro-icon/components'
---

<div class=" shadow shadow-mist-800 border-[#CCCCCC] rounded  mt-20 max-w-10/12 md:max-w-6/12  mx-auto h-8/12 bg-[#2F0923] flex flex-col gap-2 font-cascadia">
    <div class="p-2  rounded-t bg-[#2B2929]  w-full flex items-center justify-between">
        <div class="flex items-center gap-5">
            <Icon class="text-white bg-[#ED6329] rounded-full w-5 p-1 h-5" name="cross"/>
            <Icon class="text-white" name="line"/>
            <Icon size={12} class="text-[#959494]" name="square"/>
        </div>
        <div>
            <p>memdevv@u2026: -</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="text-white text-[20px]">+</span>
            <Icon name="menu-burger"/>
        </div>
    </div>
    <div class="p-2">  
        <div>
            <div id="incio-consola" class="flex flex-row items-center gap-2">
                <!-- <p id="hora" class="text-[#575656] font-bold hora"></p> -->
                <div class="font-semibold text-green-600 whitespace-nowrap shrink-0">memdevv@u2026<span class="text-white">:<span class="text-blue-500">~</span>$</span></div>
                <p class="text-white">
                    Presione una tecla para continuar <span id="type1"></span>
                </p>
            </div>

            <div class="flex flex-row items-start texto1 gap-2">
                <!-- <p id="hora2" class="text-[#575656] hidden font-bold"></p> -->
                <div id="usuario2" class="font-semibold text-green-600 hidden whitespace-nowrap shrink-0">memdevv@u2026<span class="text-white">:<span class="text-blue-500">~</span>$</span></div>
                <p class="text-white" id="type2"></p>
            </div>
            <div class="flex flex-row items-start texto2 gap-2">
                <!-- <p id="hora3" class="text-[#575656] hidden hora font-bold"></p> -->
                <div id="usuario3" class="font-semibold text-green-600 hidden whitespace-nowrap shrink-0">memdevv@u2026<span class="text-white">:<span class="text-blue-500">~</span>$</span></div>
                <p class="text-white" id="type3"></p>
            </div>
        </div>
        <div class="flex items-center consejo gap-2">
            <!-- <p id="hora4" class="text-[#575656] hidden hora font-bold"></p> -->
            <div id="usuario4" class="font-semibold text-green-600 hidden whitespace-nowrap shrink-0">memdevv@u2026<span class="text-white">:<span class="text-blue-500">~</span>$</span></div>
            <span class="text-white texto-consejo hidden">Pon 'clear' para limpiar la consola</span>
        </div>
        <div class="flex items-center">
            <div id="usuario5" class="font-semibold hidden text-green-600 whitespace-nowrap shrink-0">memdevv@u2026<span class="text-white">:<span class="text-blue-500">~</span>$</span></div>
            <input id="input" type="text" disabled class="bg-[#2F0923] text-white w-full p-2 outline-none" />
        </div>
    </div>

</div>

<script>
    import Typed from "typed.js";

    /*
    const obtenerHora = () =>
        new Date().toLocaleTimeString("es-ES", {
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
        });
    */

    //Tomar hora acutal y mostrarla
    /*
    const hora = document.querySelector("#hora") as HTMLParagraphElement | null;
    if (hora) {
        hora.textContent = obtenerHora();
    }
    */

    // Animacion de escritura en consola de los tres ...
    const typed1 = new Typed("#type1", {
        strings: [". . ."],
        typeSpeed: 300,
        backSpeed: 100,
        loop: false,
        showCursor: true,
        cursorChar: "|",
    });

    //Evitar que el usuario pueda hacer scroll mientras se ejecuta la animacion de escritura
    const body = document.querySelector("body");
    // body?.classList.add('overflow-hidden'); // Descomentar esta linea luego de terminar el portfolio
    
    // Evento para detectar cuando se presiona una tecla y ejecutar la animación de escritura
    document.addEventListener("keydown", function () {
        // Quitar la clase overflow-hidden para permitir el scroll nuevamente
        body?.classList.remove('overflow-hidden');

        const inicioConsola = document.getElementById("incio-consola");

        inicioConsola?.classList.add("hidden");
        typed1.destroy();

        /* const hora2 = document.querySelector(
            "#hora2",
        ) as HTMLParagraphElement | null;
        if (hora2) {
            hora2.textContent = obtenerHora();
            hora2.classList.remove("hidden");
        } */
        document.querySelector("#usuario2")?.classList.remove("hidden");

        const texto1 = document.querySelector(".texto1");
        const typed2 = new Typed("#type2", {
            strings: [
                "¡Hola! Soy Matías Morelli. Hace algunos años que comencé en el desarrollo web y en la programación en general, pero específicamente en backend. Aún tengo mucho que aprender.",
            ],
            typeSpeed: 30,
            loop: false,
            startDelay: 500,
            onComplete: (self) => {
                //Ocultar el otro cursor
                self.cursor.style.display = "none";

                // 2. Muestras la siguiente línea y/o inicias la nueva escritura abajo
                const texto2 = document.querySelector(".texto2");
                /* const hora3 = document.querySelector(
                    "#hora3",
                ) as HTMLParagraphElement | null;
                if (hora3) {
                    hora3.textContent = obtenerHora();
                    hora3.classList.remove("hidden");
                } */
                document.querySelector("#usuario3")?.classList.remove("hidden");
                texto2?.classList.remove("hidden");

                const typed3 = new Typed("#type3", {
                    strings: [
                        'Y ademas de la programacion me gusta crear contenido en redes sociales y compartir mis conocimientos con la comunidad. estoy en: <br> <a class="text-red-500 font-bold underline" href="https://www.youtube.com/@memdevv" target="_blank">YouTube</a> y en <a class="text-pink-400 font-bold underline" href="https://www.instagram.com/memdevv" target="_blank"">Instagram</a>',
                    ],
                    typeSpeed: 30,
                    loop: false,
                    onComplete: (self) => {
                        //Ocultar el otro cursor
                        self.cursor.style.display = "none";

                        const input = document.getElementById("input") as HTMLInputElement | null;
                        /* const hora4 = document.querySelector(
                            "#hora4",
                        ) as HTMLParagraphElement | null;
                        if (hora4) {
                            hora4.textContent = obtenerHora();
                            hora4.classList.remove("hidden");
                        } */
                        document.querySelector("#usuario4")?.classList.remove("hidden");
                        const consejo = document.querySelector(".consejo");
                        document.querySelector("#usuario5")?.classList.remove("hidden");
                        const consejoTexto = document.querySelector(".texto-consejo");
                        consejoTexto?.classList.remove("hidden");
                        consejo?.classList.remove("hidden");
                        input?.removeAttribute("disabled");
                        input?.focus();

                        input?.addEventListener("keydown", (e) => {
                            if (e.key === "Enter") {
                                const valor = input?.value ?? "";

                                if (valor.trim() === "clear") {
                                    texto1?.classList.add("hidden");
                                    texto2?.classList.add("hidden");
                                    consejo?.classList.add("hidden");
                                    typed2.destroy();
                                    typed3.destroy();
                                    const t2 = document.getElementById("type2");
                                    const t3 = document.getElementById("type3");
                                    if (t2) t2.innerHTML = "";
                                    if (t3) t3.innerHTML = "";
                                    input.value = "";
                                    input?.setAttribute("disabled", "true");
                                }
                            }
                        });
                    },
                });
            },
        });
    }, { once: true });
</script>