---

interface Props {
    hrefNombre: string;
    nombre: string;
}

const {hrefNombre, nombre} = Astro.props;

import { Icon } from "astro-icon/components";
---

<div id="portfolio" data-href=`/proyectos/${hrefNombre}`  draggable="true" class="folder-item p-2 flex flex-col text-center w-22.5">
    <div class="cursor-default">
        <Icon name='folder' size={60} class="hover:scale-[1.1] transition-all text-blue-500 hover:text-white mx-auto"/>
        <p class="text-[14px]">{nombre}</p>
    </div>
</div>