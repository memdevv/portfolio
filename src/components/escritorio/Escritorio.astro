---
import Carpeta from './Carpeta.astro';
import { Icon } from 'astro-icon/components'
---

<section id="proyectos" class="md:max-w-6/12 max-w-10/12 mx-auto w-full ">

    <h2 class="text-2xl font-bold text-center text-[#CCCCCC] mb-10">
        Proyectos
    </h2>

    <div id="escritorio-base" class="h-[50vh] flex flex-col">
        <!-- Inicio Barra -->
        <div id="barra-nav" class="bg-[#121313]">
            <div class="flex items-center justify-between px-2">
                <p>Actividades</p>
                <span id="hora-nav">30 de abr 13:00</span>
                <div class="flex items-center gap-1">
                    <Icon size={18} name="wifi"/>
                    <Icon size={18} name="sound"/>
                    <Icon size={18} name="bluetooth"/>
                </div>
            </div>
        </div>
        <!-- Fin Barra -->

        <div class="flex flex-1 min-h-0">
            <div id="menu-nav" class="flex-1 w-full h-full bg-[#1C1117]">

                <ul class="flex gap-4 flex-col justify-between h-full items-center mt-4">
                    <div class="flex flex-col gap-2">
                        <li><Icon name='terminal' size={40} class="hover:scale-[1.1] transition-all bg-white rounded"/></li>
                        <li><Icon name='cloud' size={40} class="hover:scale-[1.1] transition-all text-blue-500"/></li>
                        <li><Icon name='folder' size={40} class="hover:scale-[1.1] transition-all text-amber-600"/></li>
                    </div>
                    <div>
                        <li><Icon name='menu' size={40} class="mb-6 hover:scale-[1.1]"/></li>
                    </div>
                </ul>

            </div>

            <div id="espacio-escritorio" class="flex-16">


                <div id="contenedor" class="relative flex w-full h-full min-h-75">
                    
                    <Carpeta hrefNombre='portfolio' nombre='portfolio' />

                </div>
                <!-- Fin Contenedor -->

            </div>
        </div>
    </div>
</section>
<br>

<script>
    
    const hora = document.querySelector('#hora-nav');
    
    const horaActual = new Date()
    const opciones: Intl.DateTimeFormatOptions = { 
        day: '2-digit', 
        month: 'short', 
        hour: '2-digit', 
        minute: '2-digit',
        hour12: false
    };
    const resultado = horaActual.toLocaleString('es-ES', opciones).replace(/[.,]/g, ''); 
    if (hora) hora.textContent = resultado;
    

    const contenedor = document.getElementById('contenedor');
    const carpetas = document.querySelectorAll('.folder-item');


    carpetas.forEach(carpeta => {
        carpeta.addEventListener('dragstart', (e) => {
            if (e instanceof DragEvent && e.dataTransfer && e.currentTarget instanceof HTMLElement) {
                e.dataTransfer.setData('text/plain', e.currentTarget.id);
                e.dataTransfer.effectAllowed = 'move';
            }
        });

        carpeta.addEventListener('dblclick', (e) => {
            const elemento = e.currentTarget;
            
            if (elemento instanceof HTMLElement) {
                const url = elemento.dataset.href;
                
                if (url) {
                    window.location.href = url;
                }
            }
        });
    });

    contenedor?.addEventListener('dragover', (e) => {
        e.preventDefault();
    });

    contenedor?.addEventListener('drop', (e) => {
        e.preventDefault();
        if (!(e instanceof DragEvent) || !e.dataTransfer || !contenedor) return;

        const id = e.dataTransfer.getData('text/plain');
        const elemento = document.getElementById(id);
        const rectContenedor = contenedor.getBoundingClientRect();
        if (!elemento) return;

        let x = e.clientX - rectContenedor.left;
        let y = e.clientY - rectContenedor.top;

        elemento.style.position = 'absolute';
        elemento.style.left = `${x - 40}px`;
        elemento.style.top = `${y - 20}px`;
    });


    
    
</script>

<style>
    #espacio-escritorio {
        background-image: url('./img/fondo.jpg');
        background-position: center center;
        background-size: cover;
    }

</style>
