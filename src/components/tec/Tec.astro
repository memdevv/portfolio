---
import TecCaja from './TecCaja.astro';

---



<section id="tec" class="md:max-w-6/12 max-w-10/12 mx-auto pb-10">
    <h2 class="text-2xl font-bold text-center text-[#CCCCCC] mb-10">
        Tecnologías que utilizo
    </h2>
    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3 font-cascadia">
        <TecCaja iconNombre="astro" nombre="Astro" class="bg-purple-900" />
        <TecCaja iconNombre="htmlicon" nombre="HTML" class="bg-amber-500" classIcon="text-orange-400 bg-white w-15 h-15 p-1 rounded-2xl" />
        <TecCaja iconNombre="typescript" nombre="TypeScript" class="bg-blue-600" />
        <TecCaja iconNombre="cssicon" nombre="CSS" class="bg-blue-500" classIcon="text-blue-500 bg-white w-15 h-15 p-1 rounded-2xl" />
        <TecCaja iconNombre="jsicon" nombre="JavaScript" class="bg-amber-500" classIcon="text-amber-300 bg-white shadow rounded-[7px]" />
        <TecCaja iconNombre="postgresql" nombre="PostgreSQL" class="bg-blue-600" />

    </div>
</section>