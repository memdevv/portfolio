---
import Titulo from '../Titulo.astro';
import TecCaja from './TecCaja.astro';

---



<section id="tec" class="md:max-w-6/12 max-w-10/12 mx-auto pb-10">

    <Titulo titulo='Tecnologías que utilizo Actualmente'/>

    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3 font-cascadia">
        <TecCaja iconNombre="astro" nombre="Astro" class="bg-slate-800" />
        <TecCaja iconNombre="jsicon" nombre="JavaScript" class="bg-slate-800" classIcon="text-yellow-400 bg-slate-100 shadow rounded-[7px]" />
        <TecCaja iconNombre="typescript" nombre="TypeScript" class="bg-slate-800" />
        <TecCaja iconNombre="postgresql" nombre="PostgreSQL" class="bg-slate-800" />
        <TecCaja iconNombre="htmlicon" nombre="HTML" class="bg-slate-800" classIcon="text-orange-400 bg-slate-100 w-15 h-15 p-1 rounded-2xl" />
        <TecCaja iconNombre="cssicon" nombre="CSS" class="bg-slate-800" classIcon="text-sky-400 bg-slate-100 w-15 h-15 p-1 rounded-2xl" />

    </div>
</section>